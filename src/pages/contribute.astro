---
import Base from '../layouts/Base.astro';
import { ROLES } from '../lib/taxonomy';
import { url } from '../lib/url';
import { REPO_URL } from '../site.config';
---

<Base
  title="Contribute"
  description="How to submit a sustainability case study."
>
  <div class="wrap section">
    <div class="section__head section__head--wide">
      <div class="stack" style="--stack-gap:.75rem">
        <h1>Contributing</h1>
        <p>Share your experiences of working on sustainability in your role.</p>
        <p>
        This site is only useful if it reflects what people are really doing, including the
          things that did not work! To contribute you only need a GitHub account. 
        </p>
        <div class="button-row" style="padding-top:.25rem">
          <a class="button button--primary" href={url('/contribute/write')}>
            Write a case study
          </a>
          <a
            class="button button--ghost"
            href={`${REPO_URL}/issues/new?template=propose-article.yml`}
            rel="noopener"
          >
            Draft an idea
          </a>
        </div>
      </div>
    </div>

    <div class="prose prose--wide">
      <h2>Tips on writing a good article</h2>
      <ul>
        <li>
          Be specific. Often sustainability advice is less practical because it is too generic.
        </li>
        <li>Say what it cost in terms of effort, money, disruption, etc.</li>
        <li>Include anything that did not work.</li>
        <li>Cite any sources for things like emissions, energy or cost figures.</li>
        <li>
          Only submit content you wrote or have the right to publish. Everything here is released
          under CC&nbsp;BY&nbsp;4.0.
        </li>
      </ul>

      <h2>Roles</h2>
      <p>The target audience of the article.</p>
      <ul>
        {
          Object.entries(ROLES).map(([id, role]) => (
            <li>
              <code>{id}</code> ({role.label}): {role.description}
            </li>
          ))
        }
      </ul>

      <h2>Commenting</h2>
      <p>
        Every article has a discussion thread using GitHub Discussions. You need to be signed in with a GitHub
        account to add a question or comment.
      </p>
    </div>
  </div>
</Base>
